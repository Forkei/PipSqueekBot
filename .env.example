# Copy to .env and fill in. Never commit .env.

# Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# LLM access for the Mk2 agent, DJ/radio mode, games, wrapped, roasts.
# Set at least one. If both are set, Gemini is tried first for google/* models
# and OpenRouter is the fallback.
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Model for everything Pip says (OpenRouter-style id; default: google/gemini-3.8-flash)
PIP_MODEL=google/gemini-3.8-flash

# Pip's speaking voice for radio mode (edge-tts voice name, rate, pitch)
PIP_TTS_VOICE=en-US-BrianMultilingualNeural
PIP_TTS_RATE=+6%
PIP_TTS_PITCH=+12Hz

# Command prefix word (default: pip, so commands look like "pip play")
BOT_PREFIX=pip

# Discord username of the bot owner (can skip/pause anyone's track). Optional.
OWNER_USERNAME=your_discord_username

# Spotify import (optional) - https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Path to a YouTube cookies file (optional, for age-restricted content).
# Export it from your browser with an extension such as "Get cookies.txt LOCALLY".
YOUTUBE_COOKIES_FILE=cookies.txt

# Audio cache limits
CACHE_MAX_MB=2048
CACHE_MAX_SONGS=500

# Voice assistant (WIP, cogs.voice_assistant is not loaded by default):
# Groq key for Whisper speech-to-text
GROQ_API_KEY=your_groq_api_key_here
