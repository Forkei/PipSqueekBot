# Discord Bot Token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# OpenRouter API key — powers the Mk2 AI agent and DJ comments (required for Mk2)
OPENROUTER_API_KEY=sk-or-your_key_here

# Bot command prefix (default: !)
BOT_PREFIX=!

# Path to YouTube cookies file (optional, helps with age-restricted/premium content)
# Export cookies from your browser using a browser extension like "Get cookies.txt LOCALLY"
YOUTUBE_COOKIES_FILE=cookies.txt

# Max cache size in MB (default: 2048 = 2GB)
CACHE_MAX_MB=2048

# Max songs to keep in cache (default: 500)
CACHE_MAX_SONGS=500

# Groq API key — used by the voice assistant for Whisper STT (required for pip listen)
GROQ_API_KEY=gsk_your_key_here

# Discord owner username — used for admin bypass in some commands
OWNER_USERNAME=forkei
